PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aduana_lab3
DB_USER=aduana_app
DB_PASSWORD=
# URL del Chat Trigger de n8n; solo se usa desde el servidor.
N8N_CHAT_URL=
# Para el modo Embedded Chat con Basic Auth de n8n:
N8N_CHAT_USER=
N8N_CHAT_PASSWORD=
# Opcional si tienes un proxy con autenticación por encabezado:
N8N_HEADER_NAME=X-Aduana-Key
N8N_HEADER_KEY=
