digraph Aduana {
graph [rankdir=LR, bgcolor="#ffffff", pad="0.5", nodesep="0.55", ranksep="1.4", splines=polyline, fontname="Helvetica", label="ADUANA | MODELO RELACIONAL · 13 ENTIDADES
PK primaria · FK foránea · 1 → N · 0..1 opcional · N:M mediante detalle_declaracion", labelloc=t, fontsize=22];
node [shape=plain fontname="Helvetica"];
edge [fontname="Helvetica",fontsize=10,color="#64748b",arrowsize=0.7];
pais [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>pais</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_pais</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">codigo_iso</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR></TABLE>>];
importador [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>importador</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_importador</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">razon_social</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">identificacion</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR></TABLE>>];
agente_aduanal [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>agente_aduanal</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_agente</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">licencia</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR></TABLE>>];
partida_arancelaria [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>partida_arancelaria</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_partida</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT">VARCHAR(12)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(180)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">porcentaje_arancel</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR></TABLE>>];
producto [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_producto</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(140)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">unidad_medida</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">valor_referencia</TD><TD ALIGN="LEFT">DECIMAL(14,2)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">peso_unitario_kg</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_partida</TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
funcionario [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>funcionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_funcionario</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cargo</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_supervisor</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">session_version</TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
declaracion [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>declaracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">numero</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">regimen</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">moneda</TD><TD ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_importador</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_agente</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_pais_origen</TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
detalle_declaracion [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>detalle_declaracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD ALIGN="LEFT">id_producto</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">valor_declarado</TD><TD ALIGN="LEFT">DECIMAL(14,2)</TD></TR></TABLE>>];
contenedor [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>contenedor</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_contenedor</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">numero</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">peso_bruto_kg</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
bodega [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>bodega</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_bodega</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ubicacion</TD><TD ALIGN="LEFT">VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">capacidad_peso_kg</TD><TD ALIGN="LEFT">DECIMAL(14,3)</TD></TR></TABLE>>];
inventario [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>inventario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_inventario</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_producto</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_bodega</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fecha_ingreso</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR></TABLE>>];
movimiento [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>movimiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_movimiento</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">referencia</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_producto</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_bodega_origen</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_bodega_destino</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">estado_mercancia</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_funcionario</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT">VARCHAR(250)</TD></TR></TABLE>>];
inspeccion [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f4c900"><FONT COLOR="#101010"><B>inspeccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_inspeccion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">resultado</TD><TD ALIGN="LEFT">VARCHAR(25)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT">VARCHAR(300)</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_declaracion</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_funcionario</TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
partida_arancelaria -> producto [label="clasifica", taillabel="1", headlabel="0..N", labeldistance=2];
funcionario -> funcionario [label="supervisa", taillabel="0..1", headlabel="0..N", labeldistance=2];
