{
  "id": 3,
  "titulo": "Países con más contenedores recibidos",
  "sql": "SELECT p.nombre AS pais_origen, COUNT(c.id_contenedor) AS contenedores\nFROM contenedor c JOIN declaracion d ON d.id_declaracion=c.id_declaracion\nJOIN pais p ON p.id_pais=d.id_pais_origen GROUP BY p.id_pais,p.nombre\nORDER BY contenedores DESC,p.nombre;",
