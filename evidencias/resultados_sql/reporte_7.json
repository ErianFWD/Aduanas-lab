{
  "id": 7,
  "titulo": "Ocupación de bodegas en kilogramos y estado",
  "sql": "SELECT b.nombre,i.estado,SUM(i.cantidad*p.peso_unitario_kg) AS peso_ocupado_kg,\n b.capacidad_peso_kg, ROUND(100*SUM(i.cantidad*p.peso_unitario_kg)/b.capacidad_peso_kg,2) AS porcentaje_capacidad\nFROM bodega b JOIN inventario i ON i.id_bodega=b.id_bodega\nJOIN producto p ON p.id_producto=i.id_producto\nGROUP BY b.id_bodega,b.nombre,b.capacidad_peso_kg,i.estado ORDER BY b.nombre,i.estado;",
