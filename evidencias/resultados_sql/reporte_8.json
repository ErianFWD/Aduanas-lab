{
  "id": 8,
  "titulo": "Movimientos de octubre de 2026 por tipo y producto",
  "sql": "SELECT m.tipo,p.sku,p.descripcion,p.unidad_medida,COUNT(*) AS operaciones,SUM(m.cantidad) AS cantidad\nFROM movimiento m JOIN producto p ON p.id_producto=m.id_producto\nWHERE m.fecha>='2026-10-01' AND m.fecha<'2026-11-01'\nGROUP BY m.tipo,p.id_producto,p.sku,p.descripcion,p.unidad_medida ORDER BY m.tipo,p.sku;",
